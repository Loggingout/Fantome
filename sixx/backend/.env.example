# Copy this file to .env and replace the value with your MongoDB connection string.
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/fantome

# Optional backend settings
PORT=5000
JWT_SECRET=replace-with-a-long-random-secret
UNO_API_KEY=
EMAIL_FROM=
EMAIL_TO=
PUBLIC_API_URL=https://fantome.onrender.com
FRONTEND_URL=https://fantometechnologies.com
