{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "rewrites": [
    {
      "source": "/sitemap.xml",
      "destination": "/api/sitemap.xml"
    },
    {
      "source": "/blog/:id",
      "destination": "/api/blog-preview?id=:id"
    },
    {
      "source": "/(.*)",
      "destination": "/"
    }
  ]
}
